# Copia este fichero a .env y rellena los valores. NO subas .env al repo.

# ── Base de datos ──
POSTGRES_DB=listillo
POSTGRES_USER=listillo
POSTGRES_PASSWORD=cambia-esto

# ── GitHub Packages (libs ng-* y spring-*) ──
# Token con read:packages. En Coolify, márcalo como "Build Variable".
GITHUB_TOKEN=

# ── Seguridad ──
# Secreto del JWT, mínimo 32 caracteres.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
CORS_ORIGINS=*

# ── Entrar con Google ──
# Client-id de OAuth de tipo «Aplicación web» (consola de Google Cloud), con el dominio
# de la PWA en «Orígenes de JavaScript autorizados». Sin él, deja HABILITADO=false.
GOOGLE_HABILITADO=false
GOOGLE_CLIENT_ID=

# ── Administración ──
# Solo se crea si la base está vacía. Entrando con Google con ese mismo correo, se vincula.
CREATE_DEFAULT_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Front ──
# Puerto del host en LOCAL (docker-compose.override.yml). En el VPS no se usa.
FRONT_PORT=8080

# Open Food Facts pide un correo de contacto en el User-Agent
OFF_CONTACTO=

# Precios de las webs de los súper (Mercadona, Consum, Ahorramás, Eroski, Caprabo, Aldi,
# Lidl). APAGADO por defecto: leer webs de terceros solo para uso privado.
PRECIOS_WEB=false
# Almacén de Mercadona cuyos precios se leen (mad1 = Madrid)
MERCADONA_ALMACEN=mad1

# Precios de Open Prices (datos abiertos, ODbL) para las cadenas cuya web no se lee
# (Carrefour, Dia, Alcampo…; todas si PRECIOS_WEB=false). Encendido por defecto.
OPEN_PRICES=true
