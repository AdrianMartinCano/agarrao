{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "marca",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/fuentes/**",
          "/personajes/**",
          "/iconos/**"
        ]
      }
    },
    {
      "name": "lector",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/zxing/**",
          "/tesseract/**"
        ]
      }
    }
  ]
}
